[Unit]
Description=Weltverbund Logistik – Testinstanz (Testwelten)
After=network-online.target docker.service logistik.service
Wants=network-online.target

[Service]
Type=simple
User=logistik
Group=logistik
WorkingDirectory=/opt/logistik/app-test
EnvironmentFile=/etc/logistik/logistik.env
Environment=HOME=/opt/logistik
ExecStart=/bin/bash -c 'export PORT="$${TEST_PORT:-8788}" LOGISTIK_INSTANCE=test; exec /bin/bash /opt/logistik/app-test/deploy/start.sh'
Restart=always
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
