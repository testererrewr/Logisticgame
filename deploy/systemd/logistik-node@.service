[Unit]
Description=Weltverbund Logistik – Weltserver %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=logistik
Group=logistik
WorkingDirectory=/opt/logistik-%i/app
EnvironmentFile=/etc/logistik/%i.env
Environment=HOME=/opt/logistik
ExecStart=/bin/bash /opt/logistik-%i/app/deploy/start.sh
Restart=always
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
