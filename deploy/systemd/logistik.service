[Unit]
Description=Weltverbund Logistik – Spielserver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=logistik
Group=logistik
WorkingDirectory=/opt/logistik/app
EnvironmentFile=/etc/logistik/logistik.env
Environment=HOME=/opt/logistik
ExecStart=/bin/bash /opt/logistik/app/deploy/start.sh
Restart=always
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
